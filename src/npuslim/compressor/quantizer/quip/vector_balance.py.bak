"""
Vector Balance / LDLQ quantization algorithms from QuIP.
Reference: https://github.com/Cornell-RelaxML/QuIP/blob/master/vector_balance.py
"""

import torch
import sys


def _allonce(x, w, unbiased=False):
    """Rounding helper function."""
    if unbiased:
        z = torch.floor(w - x + torch.rand(x.shape).to(x.device))
    else:
        z = torch.round(w - x)
    return w - z


def round_ldl(w, H, nbits, n_greedy_passes=9, unbiased=False):
    """
    LDL quantization algorithm (non-blocked version, matching original QuIP).

    Args:
        w: Weight tensor [m, d] (m=out_features, d=in_features)
        H: Hessian matrix [d, d]
        nbits: Number of bits for quantization
        n_greedy_passes: Number of greedy refinement passes
        unbiased: Whether to use unbiased rounding

    Returns:
        Quantized weight tensor
    """
    assert (not unbiased) or (n_greedy_passes == 0), \
        "greedy passes are incompatible with unbiased LDL rounding"

    (d, d_) = H.shape
    assert (d == d_)
    (m, d) = w.shape

    # Cholesky decomposition
    L = torch.linalg.cholesky(H)
    L = L @ torch.diag(1 / torch.diag(L))
    L = L - torch.eye(d, device=L.device)

    if unbiased:
        eta = torch.rand(w.shape).to(w.device)
    else:
        eta = 0.5 * torch.ones(w.shape).to(w.device)

    w_hat = w.clone()

    # LDL pass (non-blocked, processing in reverse order)
    for i in reversed(range(d)):
        w_hat[:, i] = torch.clamp(
            torch.floor(w[:, i] + (w[:, i:] - w_hat[:, i:]) @ L[i:, i] + eta[:, i]),
            min=0, max=2**nbits - 1
        )

    # Greedy refinement passes
    wr = w_hat.clone()
    s = w_hat - w
    H = H / H.diag().max()

    for igp in range(n_greedy_passes):
        for i in reversed(range(d)):
            Hs = s @ H[:, i]
            epsXTsj = wr[:, i] - torch.round(wr[:, i] - Hs / H[i, i])
            wr[:, i] -= epsXTsj
            s[:, i] -= epsXTsj

        wr = torch.clamp(wr, min=0, max=2**nbits - 1)
        if (w_hat == wr).all():
            sys.stderr.write(f"breaking after {igp+1} greedy passes found fixed point\n")
            break
        w_hat.copy_(wr)

    return wr


def round_ldl_block(w, H, nbits, n_greedy_passes=9, unbiased=False, blocksize=128):
    """
    LDL quantization algorithm (blocked version for efficiency).

    Args:
        w: Weight tensor [m, d] (m=out_features, d=in_features)
        H: Hessian matrix [d, d]
        nbits: Number of bits for quantization
        n_greedy_passes: Number of greedy refinement passes
        unbiased: Whether to use unbiased rounding
        blocksize: Block size for block-wise processing

    Returns:
        Quantized weight tensor
    """
    assert (not unbiased) or (n_greedy_passes == 0), \
        "greedy passes are incompatible with unbiased LDL rounding"

    (d, d_) = H.shape
    assert (d == d_)
    (m, d) = w.shape

    # Cholesky decomposition
    L = torch.linalg.cholesky(H)
    L = L @ torch.diag(1 / torch.diag(L))
    L = L - torch.eye(d, device=L.device)

    if unbiased:
        eta = torch.rand(w.shape).to(w.device)
    else:
        eta = 0.5 * torch.ones(w.shape).to(w.device)

    w_hat = w.clone()

    # LDL pass (block-wise for efficiency)
    for i2 in range(d, 0, -blocksize):
        i1 = max(i2 - blocksize, 0)
        count = i2 - i1
        W1 = w[:, i1:i2]
        W2Hdiff = w[:, i2:] - w_hat[:, i2:]
        WHat1 = w_hat[:, i1:i2].clone()
        L1 = L[:, i1:i2]
        Eta1 = eta[:, i1:i2]

        for i in reversed(range(count)):
            WHat1[:, i] = torch.clamp(
                torch.floor(W1[:, i] + (W1 - WHat1) @ L1[i1:i2, i] + W2Hdiff @ L1[i2:, i] + Eta1[:, i]),
                min=0, max=2**nbits - 1
            )

        w_hat[:, i1:i2] = WHat1

    # Greedy refinement passes
    wr = w_hat.clone()
    s = w_hat - w
    H = H / H.diag().max()

    for igp in range(n_greedy_passes):
        for i2 in range(d, 0, -blocksize):
            i1 = max(i2 - blocksize, 0)
            count = i2 - i1
            W1 = wr[:, i1:i2].clone()
            S0 = s[:, :i1]
            S1 = s[:, i1:i2].clone()
            S2 = s[:, i2:]
            H0 = H[:i1, i1:i2]
            H1 = H[i1:i2, i1:i2]
            H2 = H[i2:, i1:i2]

            for i in reversed(range(count)):
                Hs = S0 @ H0[:, i] + S1 @ H1[:, i] + S2 @ H2[:, i]
                epsXTsj = W1[:, i] - torch.round(W1[:, i] - Hs / H1[i, i])
                W1[:, i] -= epsXTsj
                S1[:, i] -= epsXTsj

            wr[:, i1:i2] = W1
            s[:, i1:i2] = S1

        wr = torch.clamp(wr, min=0, max=2**nbits - 1)
        if (w_hat == wr).all():
            sys.stderr.write(f"breaking after {igp+1} greedy passes found fixed point\n")
            break
        w_hat.copy_(wr)

    return wr


def round_ldl_gptqequiv(w, H, nbits, unbiased=False):
    """
    LDL quantization that is mathematically equivalent to GPTQ.
    Used for verification purposes.
    """
    (d, d_) = H.shape
    assert (d == d_)
    (m, d) = w.shape

    H = torch.flip(H, [0, 1])
    L = torch.linalg.cholesky(H)
    L = torch.flip(L, [0, 1])
    L = L @ torch.diag(1 / torch.diag(L))
    L = L - torch.eye(d, device=L.device)

    if unbiased:
        eta = torch.rand(w.shape).to(w.device)
    else:
        eta = 0.5 * torch.ones(w.shape).to(w.device)

    w_hat = w.clone()
    for i in range(d):
        w_hat[:, i] = torch.clamp(
            torch.floor(w[:, i] + (w[:, :i+1] - w_hat[:, :i+1]) @ L[:i+1, i] + eta[:, i]),
            min=0, max=2**nbits - 1
        )

    return w_hat


@torch.no_grad()
def quantize_weight_vecbal(
    w,
    H,
    nbits,
    npasses,
    scale,
    zero,
    maxq,
    unbiased=False,
    qfn='a',
    qmethod='ldlq',
    lazy_batch=False,
    blocksize=128,
):
    """
    Main quantization function for QuIP.

    Args:
        w: Weight tensor [m, d]
        H: Hessian matrix [d, d]
        nbits: Number of bits
        npasses: Number of greedy passes
        scale: Quantization scale
        zero: Zero point
        maxq: Maximum quantization value (2^nbits - 1)
        unbiased: Use unbiased rounding
        qfn: Quantization function ('a' for minmax, 'b' for RMS)
        qmethod: Quantization method ('ldlq', 'ldl_gptqequiv', etc.)
        lazy_batch: Use blocked version for efficiency (default: False)
        blocksize: Block size for processing (only used when lazy_batch=True)

    Returns:
        Quantized weight tensor (float16)
    """
    # Select LDL rounding function based on lazy_batch
    if lazy_batch:
        round_fn = lambda w, H: round_ldl_block(
            w.float(), H, nbits, n_greedy_passes=npasses,
            unbiased=unbiased, blocksize=blocksize
        )
    else:
        round_fn = lambda w, H: round_ldl(
            w.float(), H, nbits, n_greedy_passes=npasses,
            unbiased=unbiased
        )

    if (qfn == 'a') and (qmethod == 'ldl_gptqequiv'):
        # GPTQ-equivalent path
        wr = round_ldl_gptqequiv((w / scale) + zero, H, nbits=nbits, unbiased=unbiased)
        return scale * (wr - zero)

    elif qfn == 'a':
        # Standard minmax quantization with LDL refinement
        # NOTE: Original QuIP uses round_vecbal_Hsort which does w.float() conversion
        wr = torch.clamp((w / scale) + zero, 0, maxq)
        wr = round_fn(wr, H)
        wr = scale * (wr - zero)
        return wr.half()

    elif qfn == 'b':
        # RMS quantization (QuIP's default with incoherence processing)
        # NOTE: Original QuIP uses round_vecbal_Hsort which does w.float() conversion
        scale = 2.4 * w.square().mean().sqrt() + 1e-16
        wr = w / scale
        wr = torch.clamp(((wr + 1) / 2) * maxq, 0, maxq)
        wr = round_fn(wr, H)
        wr = (wr / maxq) * 2 - 1
        wr = wr * scale
        return wr.half()

    else:
        raise NotImplementedError(f"Unknown qfn: {qfn}")
